NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://eventvivid:eventvivid@localhost:5432/eventvivid
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eventvivid:eventvivid@localhost:5672
WEB_ORIGIN=http://localhost:5173
HQ_WEB_ORIGIN=http://localhost:5174
JWT_SECRET=replace-with-at-least-32-random-characters
HQ_ADMIN_USERNAME=admin
HQ_ADMIN_PASSWORD=replace-with-a-strong-initial-password
TENANT_JWT_SECRET=replace-with-another-32-character-random-secret
TENANT_ADMIN_USERNAME=tenantadmin
TENANT_ADMIN_PASSWORD=replace-with-a-strong-initial-password
VITE_API_URL=http://localhost:3000/api/v1

# 平台销售电子票额度使用汇付斗拱聚合支付；以下信息仅在服务端配置。
HUIFU_SYS_ID=6666000244121044
HUIFU_ID=6666000245068152
HUIFU_PRODUCT_ID=XLSISV
HUIFU_TRADE_TYPE=T_JSAPI
HUIFU_RSA_PRIVATE_KEY=
HUIFU_RSA_PUBLIC_KEY=
HUIFU_WECHAT_APP_ID=wx045c795cbf87164c
HUIFU_WECHAT_APP_SECRET=
HUIFU_NOTIFY_URL=
# 默认关闭真实支付；配齐参数并完成商户/公众号授权后才启用。
HUIFU_PAYMENTS_ENABLED=false
HUIFU_ENV=sandbox
# 推荐将私钥置于 Git 忽略的 .secrets/ 文件，仅后端进程可读；绝不能写入前端或提交 Git。
# 路径相对于 apps/api 的进程工作目录。使用文件时优先于 HUIFU_RSA_PRIVATE_KEY。
HUIFU_PRIVATE_KEY_FILE=
# 两份已提供公钥有代码默认值；密钥轮换时通过这两个参数覆盖。
HUIFU_PROVIDER_PUBLIC_KEY=
# 同一个公网 HTTPS 域名，反向代理 /api/v1 到后端，其他路径到活动平台。
HUIFU_CHECKOUT_ORIGIN=
HUIFU_API_ORIGIN=
HUIFU_CHECKOUT_SECRET=
# Go 模块默认位于 tools/huifu-sdk/dist/，部署到其他目录时覆盖。
HUIFU_SDK_BINARY=
